# Painel administrativo
ADMIN_USERNAME=axion_admin
ADMIN_PASSWORD=troque-por-uma-senha-longa
ADMIN_SESSION_SECRET=gere-ao-menos-48-bytes-aleatorios

# Firebase Admin. Em produção, prefira FIREBASE_SERVICE_ACCOUNT como JSON em
# um secret manager. O caminho abaixo é apenas para desenvolvimento local.
FIREBASE_PROJECT_ID=axion-badfa
FIREBASE_DATABASE_URL=https://axion-badfa-default-rtdb.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=./credencial firebase admin/service-account.json
FIREBASE_SERVICE_ACCOUNT=

# Mercado Pago Orders/Pix. Nunca use estas chaves no Android ou no Firebase
# público. Comece com credenciais de teste.
MERCADO_PAGO_MODE=sandbox
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PIX_EXPIRATION_MINUTES=30

# URL HTTPS publicada do mesmo servidor TanStack Start.
PUBLIC_BASE_URL=http://localhost:3000
